{
    "name": "acrnogor/audit-api-bundle",
    "description": "Symfony bundle providing an API interface for damienharper/auditor-bundle audits.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": ["symfony", "bundle", "audit", "api"],
    "homepage": "https://github.com/acrnogor/audit-api-bundle",
    "authors": [
        {
            "name": "Ante Crnogorac"
        }
    ],
    "require": {
        "php": ">=8.4",
        "damienharper/auditor-bundle": "^6.3 || ^7.0",
        "doctrine/dbal": "^3.6 || ^4.0",
        "symfony/config": "^6.4 || ^7.0",
        "symfony/dependency-injection": "^6.4 || ^7.0",
        "symfony/framework-bundle": "^6.4 || ^7.0",
        "symfony/http-foundation": "^6.4 || ^7.0",
        "symfony/http-kernel": "^6.4 || ^7.0",
        "symfony/property-access": "^6.4 || ^7.0",
        "symfony/routing": "^6.4 || ^7.0",
        "symfony/serializer": "^6.4 || ^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "symfony/browser-kit": "^6.4 || ^7.0"
    },
    "autoload": {
        "psr-4": {
            "Acrnogor\\AuditApiBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Acrnogor\\AuditApiBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    }
}
